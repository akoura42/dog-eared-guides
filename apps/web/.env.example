# Copy to .env for local dev; set the same vars in the Cloudflare Pages
# project for production. Every var silently defaults to '' — a missing
# value never fails the build, it just drops the feature from every page
# (no ads, no analytics, no affiliate tags). Check these first when a
# revenue or analytics number goes quiet.

# Canonical origin used for sitemap, OG image URLs, and JSON-LD.
SITE_URL=https://dogearedguides.com

# Monetization (src/lib/affiliate.ts)
BOOKING_AFFILIATE_AID=
VIATOR_PARTNER_ID=
PET_INSURANCE_URL=
PET_INSURANCE_PARTNER=

# Ads + analytics (src/lib/site.ts). PUBLIC_ vars are inlined into
# client-side code by Astro.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_GMAPS_API_KEY=
PUBLIC_GA4_ID=
PUBLIC_CF_ANALYTICS_TOKEN=

# --- Pipeline (read from the shell env, not this file; listed here as the
# single inventory of everything the repo consumes) ---
# PIPELINE_ENGINE=claude-code   # or "api" (then ANTHROPIC_API_KEY required)
# ANTHROPIC_API_KEY=
# MODEL=claude-opus-5           # model override for generate/verify
# CLAUDE_CODE_OAUTH_TOKEN=      # used by .github/workflows/verify.yml
