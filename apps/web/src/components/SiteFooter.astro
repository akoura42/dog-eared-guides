---
import { BRAND_NAME } from '~/lib/site';
import { getCities } from '~/lib/config';

const cities = getCities().filter((c) => c.launched);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="brand">
        <svg viewBox="0 0 240 240" width="26" height="26" aria-hidden="true">
          <g transform="translate(0,18)" stroke-linejoin="round" stroke-linecap="round">
            <path d="M 56 52 C 52 30 56 10 70 4 Q 78 0 86 5 C 100 16 108 34 110 52 Z" fill="#2F6047" stroke="#20302A" stroke-width="13"/>
            <path d="M 64 40 H 130 L 196 106 V 176 Q 196 202 170 202 H 72 Q 46 202 46 176 V 58 Q 46 40 64 40 Z" fill="#F4EEDF" stroke="#20302A" stroke-width="13"/>
            <path d="M 130 40 C 127 66 131 90 142 104 C 157 118 182 117 196 106 Z" fill="#2F6047" stroke="#20302A" stroke-width="13"/>
            <circle cx="98" cy="126" r="11" fill="#20302A"/>
            <circle cx="144" cy="126" r="11" fill="#20302A"/>
            <path d="M 106 152 H 136 Q 143 152 139 160 L 126 175 Q 121 180 116 175 L 103 160 Q 99 152 106 152 Z" fill="#20302A"/>
          </g>
        </svg>
        {BRAND_NAME}
      </p>
      <p class="tag">
        Deep, verified dog-friendly city guides. Every policy checked against an
        official source — and re-checked every 90 days.
      </p>
    </div>
    <div>
      <p class="head">Cities</p>
      {cities.slice(0, 6).map((city) => (
        <a href={`/${city.slug}/`}>{city.name}, {city.state_code}</a>
      ))}
      {cities.length > 6 && <a href="/#cities">All {cities.length} cities →</a>}
    </div>
    <div>
      <p class="head">Trust</p>
      <a href="/how-we-verify/">How we verify</a>
      <a href="/dog-eared-index/">The Dog-Eared Index</a>
      <a href="/editorial-policy/">Editorial policy</a>
      <a href="/about/">About</a>
    </div>
    <div>
      <p class="head">Legal</p>
      <a href="/disclosure/">Affiliate disclosure</a>
      <a href="/privacy/">Privacy &amp; cookies</a>
    </div>
  </div>
  <div class="wrap fine">
    <p>
      © {year} {BRAND_NAME}. Policies change — always confirm with the venue
      before making a trip. Some links may earn us a commission at no cost to
      you. <a href="/disclosure/">Details</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--pine-deep);
    color: #e7efe9;
    margin-top: 4rem;
    padding: 3rem 0 1.5rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 640;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .tag {
    font-size: 0.9rem;
    color: #b9cbc0;
    max-width: 26rem;
  }
  .head {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sun);
    margin-bottom: 0.6rem;
  }
  .cols a {
    display: block;
    color: #e7efe9;
    text-decoration: none;
    font-size: 0.95rem;
    margin-bottom: 0.45rem;
  }
  .cols a:hover {
    color: var(--sun);
  }
  .fine {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.82rem;
    color: #9fb5a8;
  }
  .fine a {
    color: #cfe0d5;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
