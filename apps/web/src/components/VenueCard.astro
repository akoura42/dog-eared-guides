---
import { Image } from 'astro:assets';
import type { Venue } from '~/lib/venues';
import { venuePath, ALLOWED_LABELS } from '~/lib/venues';
import { getCategoryByKey } from '~/lib/config';
import { venueLogoUrl, isAgencyWebsite } from '~/lib/logos';
import { resolvePhoto } from '~/lib/photos';
import { inSeason, formatMD } from '~/lib/season';
import VerifiedBadge from './VerifiedBadge.astro';

interface Props {
  venue: Venue;
  /** Render the category pill (off on category hub pages where it's redundant). */
  showCategory?: boolean;
}

const { venue, showCategory = true } = Astro.props;
const d = venue.data;
const category = getCategoryByKey(d.category);
const fetchedLogoUrl = venueLogoUrl(venue);
// Tile priority: a business's own logo wins; for agency-run venues (whose
// "logo" is the shared TCPUD/State Parks/USFS favicon) a licensed photo
// beats the favicon. Full credit renders on the venue page; the thumb
// carries it as title.
const photoMeta =
  d.image && (!fetchedLogoUrl || isAgencyWebsite(d.city, d.website)) ? resolvePhoto(d.image) : null;
const logoUrl = photoMeta ? null : fetchedLogoUrl;
// Off-season flag, computed at build from the venue's own published dates.
const offSeason = d.season !== null && !inSeason(d.season);
---

<article class="venue-card">
  <div class="top">
    {showCategory && <span class="pill">{category.label}</span>}
    <VerifiedBadge
      date={d.verification.last_verified}
      method={d.verification.method}
      level={d.verification.level}
      compact
    />
  </div>
  <div class="name-row">
    {logoUrl && <img class="logo" src={logoUrl} alt="" width="34" height="34" loading="lazy" />}
    {photoMeta && (
      <Image
        class="logo photo-thumb"
        src={photoMeta}
        alt=""
        width={68}
        height={68}
        fit="cover"
        loading="lazy"
        title={d.image_credit ? `Photo: ${d.image_credit}` : undefined}
      />
    )}
    <h3><a href={venuePath(venue)}>{d.name}</a></h3>
  </div>
  <p class="policy-line">
    {offSeason && <span class="offseason">Off-season until {formatMD(d.season!.opens)}</span>}
    {ALLOWED_LABELS[d.dog_policy.allowed]}{d.dog_policy.fee ? ` · ${d.dog_policy.fee}` : ''}
  </p>
  <p class="summary">{d.summary}</p>
  {d.neighborhood && <p class="hood">{d.neighborhood}</p>}
</article>

<style>
  .venue-card {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .venue-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 4px rgba(36, 49, 42, 0.08), 0 8px 24px rgba(36, 49, 42, 0.1);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.2rem;
  }
  .logo {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--line);
    padding: 2px;
  }
  .photo-thumb {
    object-fit: cover;
    padding: 0;
  }
  h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  h3 a {
    text-decoration: none;
    color: var(--pine-deep);
  }
  h3 a:hover {
    color: var(--clay);
  }
  .policy-line {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ok);
    margin: 0;
  }
  .offseason {
    display: inline-block;
    background: color-mix(in srgb, #c08a2e 16%, transparent);
    color: #8a6220;
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
    font-size: 0.75rem;
    margin-right: 0.35rem;
  }
  .summary {
    font-size: 0.93rem;
    color: var(--ink-soft);
    margin: 0;
    flex: 1;
  }
  .hood {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--moss);
    margin: 0;
  }
</style>
