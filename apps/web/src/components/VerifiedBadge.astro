---
import { formatVerifiedDate } from '~/lib/venues';

interface Props {
  date: Date;
  method: string;
  sourceUrl?: string | null;
  level?: 'official' | 'reported';
  compact?: boolean;
}

const METHOD_LABELS: Record<string, string> = {
  official_website: 'via official website',
  phone: 'by phone',
  in_person: 'in person',
  other: '',
};

const { date, method, sourceUrl = null, level = 'official', compact = false } = Astro.props;
const methodLabel = METHOD_LABELS[method] ?? '';
const isOfficial = level === 'official';
---

<span
  class:list={['verified', { compact, reported: !isOfficial }]}
  title={isOfficial
    ? 'Dog policy checked against an official source'
    : 'No official source — based on independent visitor reports, unconfirmed by the venue'}
>
  {isOfficial ? (
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <circle cx="8" cy="8" r="8" fill="var(--ok)" />
      <path d="M4.5 8.2l2.3 2.3 4.7-5" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  ) : (
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <circle cx="8" cy="8" r="8" fill="var(--warn)" />
      <path d="M8 4.2v4.6M8 11.4v.4" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" />
    </svg>
  )}
  <span>
    {isOfficial ? (
      <>
        Verified {formatVerifiedDate(date)}
        {!compact && methodLabel && <span class="method">{methodLabel}</span>}
        {!compact && sourceUrl && (
          <a class="src" href={sourceUrl} rel="nofollow noopener" target="_blank">source</a>
        )}
      </>
    ) : (
      <>
        Visitor-reported
        {!compact && <span class="method">checked {formatVerifiedDate(date)} · unconfirmed by the venue</span>}
      </>
    )}
  </span>
</span>

<style>
  .verified {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ok);
  }
  .verified.reported {
    color: var(--warn);
  }
  .verified.compact {
    font-size: 0.78rem;
  }
  .method {
    font-weight: 450;
    color: var(--ink-soft);
  }
  .src {
    font-weight: 450;
    color: var(--ink-soft);
    margin-left: 0.25rem;
  }
</style>
