---
// GA4 (consent-gated) + Cloudflare Web Analytics (cookieless, loads always).
// Both no-op unless their env vars are set.
import { GA4_ID, CF_ANALYTICS_TOKEN } from '~/lib/site';
---

{CF_ANALYTICS_TOKEN && (
  <script
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
  />
)}

{GA4_ID && (
  <script is:inline define:vars={{ GA4_ID }}>
    function loadGA() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA4_ID, { anonymize_ip: true });
    }
    if (localStorage.getItem('cookie-consent') === 'granted') {
      loadGA();
    } else {
      window.addEventListener('consent:granted', loadGA, { once: true });
    }
  </script>
)}
