---
// Landing-page map with a Zillow-style filter bar on top: search, state
// dropdown, and pin-type toggle chips. Pins ARE the navigation — clicking
// a live-guide pin goes straight to that city's guide.
//
// Renders as a build-time inline SVG map of the US (no runtime map library,
// no tile requests) unless PUBLIC_GMAPS_API_KEY is set, in which case it
// upgrades to an interactive Google Map.
//
// us-atlas ships geometry pre-projected with geoAlbersUsa()
// .scale(1300).translate([487.5, 305]) into a 975x610 viewBox; we use the
// same projection for city coordinates so dots land exactly.
import { geoAlbersUsa } from 'd3-geo';
import * as topojson from 'topojson-client';
import statesAtlas from 'us-atlas/states-albers-10m.json';
import type { CityConfig, UpcomingTown } from '~/lib/config';
import { GMAPS_API_KEY } from '~/lib/site';

interface Props {
  cities: CityConfig[];
  /** "Coming soon" towns — small muted dots, no links. */
  upcoming?: UpcomingTown[];
}

const { cities, upcoming = [] } = Astro.props;

const topo = statesAtlas as any;
const projection = geoAlbersUsa().scale(1300).translate([487.5, 305]);

// SVG path for all state borders (interior mesh) + nation outline.
// Geometry is pre-projected, so paths are just the raw coordinates.
function toPath(geom: any): string {
  const polys =
    geom.type === 'Polygon' ? [geom.coordinates] : geom.coordinates;
  return polys
    .map((rings: number[][][]) =>
      rings
        .map(
          (ring) =>
            'M' + ring.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L') + 'Z'
        )
        .join('')
    )
    .join('');
}

const nation = toPath(
  (topojson.merge as any)(topo, topo.objects.states.geometries)
);
const borders = (() => {
  const mesh = (topojson.mesh as any)(topo, topo.objects.states, (a: any, b: any) => a !== b);
  return mesh.coordinates
    .map(
      (line: number[][]) =>
        'M' + line.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')
    )
    .join('');
})();

const dots = cities
  .map((city) => {
    const pt = projection([city.geo.lng, city.geo.lat]);
    if (!pt) return null;
    return { city, x: pt[0], y: pt[1] };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);

const upcomingDots = upcoming
  .map((town) => {
    const pt = projection([town.lng, town.lat]);
    if (!pt) return null;
    return { town, x: pt[0], y: pt[1] };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);

const searchText = (name: string, state: string, code: string) =>
  `${name} ${state} ${code}`.toLowerCase();

// Mode-independent pin index for the filter bar (search + counts).
const allPins = [
  ...cities.map((c) => ({
    kind: 'live',
    search: searchText(c.name, c.state, c.state_code),
    state: c.state_code,
  })),
  ...upcoming.map((t) => ({
    kind: 'soon',
    search: searchText(t.name, t.state, t.state_code),
    state: t.state_code,
  })),
];

const stateOptions = [...new Map(
  [...cities, ...upcoming].map((p) => [p.state_code, p.state])
).entries()].sort(([, a], [, b]) => a.localeCompare(b));
---

<div class="city-map">
  <div class="map-filters" data-pins={JSON.stringify(allPins)}>
    <input
      type="search"
      id="map-search"
      placeholder={`Search ${cities.length + upcoming.length} towns…`}
      aria-label="Search towns on the map"
      autocomplete="off"
    />
    <select id="map-state" aria-label="Filter by state">
      <option value="">All states</option>
      {stateOptions.map(([code, name]) => <option value={code}>{name}</option>)}
    </select>
    <div class="pin-toggles" role="group" aria-label="Filter map pins by type">
      <button type="button" class="chip" data-kind="live" aria-pressed="true">
        <i class="live"></i>Live guides <span class="n">{cities.length}</span>
      </button>
      <button type="button" class="chip" data-kind="soon" aria-pressed="true">
        <i class="soon"></i>Coming soon <span class="n">{upcoming.length}</span>
      </button>
    </div>
    <p class="map-count" aria-live="polite"><span id="map-count">{allPins.length}</span> shown</p>
  </div>

  <div class="map-body" aria-label="Map of covered cities">
    {GMAPS_API_KEY && (
      <div
        id="us-gmap"
        data-gmaps-key={GMAPS_API_KEY}
        data-cities={JSON.stringify(
          cities.map((c) => ({
            name: c.name,
            code: c.state_code,
            state: c.state,
            slug: c.slug,
            lat: c.geo.lat,
            lng: c.geo.lng,
          }))
        )}
        data-upcoming={JSON.stringify(
          upcoming.map((t) => ({
            name: t.name,
            code: t.state_code,
            state: t.state,
            lat: t.lat,
            lng: t.lng,
            tier: t.tier,
          }))
        )}
      ></div>
    )}
    {!GMAPS_API_KEY && (
    <svg viewBox="0 0 975 610" role="img">
      <path class="nation" d={nation}></path>
      <path class="borders" d={borders}></path>
      {upcomingDots.map(({ town, x, y }) => (
        <circle
          cx={x}
          cy={y}
          r={town.tier === 1 ? 3 : 2}
          class="upcoming"
          data-pin="soon"
          data-search={searchText(town.name, town.state, town.state_code)}
          data-state={town.state_code}
        >
          <title>{town.name}, {town.state_code} — coming soon</title>
        </circle>
      ))}
      {dots.map(({ city, x, y }) => (
        <a
          href={`/${city.slug}/`}
          class="dot"
          data-pin="live"
          data-search={searchText(city.name, city.state, city.state_code)}
          data-state={city.state_code}
          aria-label={`${city.name}, ${city.state_code} — open the guide`}
        >
          <circle cx={x} cy={y} r="14" class="halo"></circle>
          <circle cx={x} cy={y} r="6.5" class="pin"></circle>
          <text
            x={x}
            y={y - 14}
            text-anchor="middle"
            class="label"
          >{city.name}, {city.state_code}</text>
        </a>
      ))}
    </svg>
    )}
  </div>
</div>

<style>
  .city-map {
    margin: 1.25rem 0 0.5rem;
  }
  .map-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding: 0.65rem 0.85rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    border-bottom: none;
  }
  #map-search,
  #map-state {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.45rem 0.9rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
  }
  #map-search {
    flex: 1 1 12rem;
    min-width: 10rem;
  }
  #map-search:focus,
  #map-state:focus {
    outline: 2px solid var(--moss);
    outline-offset: 1px;
  }
  .pin-toggles {
    display: flex;
    gap: 0.4rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    background: none;
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink-soft);
    cursor: pointer;
    transition: opacity 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .chip:hover {
    border-color: var(--moss);
    background: color-mix(in srgb, var(--moss) 8%, transparent);
  }
  .chip .n {
    font-size: 0.72rem;
    font-weight: 700;
    opacity: 0.8;
  }
  .chip i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .chip i.live {
    background: var(--clay);
  }
  .chip i.soon {
    background: var(--moss);
    opacity: 0.6;
  }
  .chip[aria-pressed='false'] {
    opacity: 0.45;
  }
  .chip[aria-pressed='false'] i {
    background: transparent;
    box-shadow: inset 0 0 0 2px currentColor;
  }
  .map-count {
    margin: 0 0 0 auto;
    font-size: 0.85rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .map-count span {
    font-weight: 700;
    color: var(--ink);
  }
  .map-body {
    border: 1px solid var(--line);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    background: color-mix(in srgb, var(--moss) 12%, var(--paper-raised));
  }
  #us-gmap {
    height: 520px;
  }
  @media (max-width: 640px) {
    #us-gmap {
      height: 400px;
    }
    .map-count {
      margin-left: 0;
    }
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  :global(.pin-hidden) {
    display: none;
  }
  .nation {
    fill: color-mix(in srgb, var(--moss) 16%, var(--paper-raised));
    stroke: none;
  }
  .borders {
    fill: none;
    stroke: color-mix(in srgb, var(--moss) 35%, var(--paper));
    stroke-width: 1;
  }
  .upcoming {
    fill: var(--moss);
    opacity: 0.4;
  }
  .upcoming:hover {
    opacity: 0.9;
  }
  .dot {
    cursor: pointer;
  }
  .halo {
    fill: var(--clay);
    opacity: 0.15;
    transition: opacity 0.15s ease;
  }
  .pin {
    fill: var(--clay);
    stroke: var(--paper-raised);
    stroke-width: 2;
    transition: r 0.15s ease;
  }
  .label {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 650;
    fill: var(--pine-deep);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .dot:hover .label,
  .dot:focus .label {
    opacity: 1;
  }
  .dot:hover .halo,
  .dot:focus .halo {
    opacity: 0.35;
  }
  @media (max-width: 640px) {
    .label {
      font-size: 19px;
    }
  }
</style>

<script>
  import { ensureGoogleMaps } from '~/lib/gmaps-loader';

  type PinData = { kind: string; search: string; state: string };

  const searchInput = document.getElementById('map-search') as HTMLInputElement | null;
  const stateSelect = document.getElementById('map-state') as HTMLSelectElement | null;
  const countEl = document.getElementById('map-count');
  const filterBar = document.querySelector<HTMLElement>('.map-filters');
  const allPins: PinData[] = filterBar ? JSON.parse(filterBar.dataset.pins!) : [];
  const kinds: Record<string, boolean> = { live: true, soon: true };
  let googleApply: (() => void) | null = null;

  function matches(pin: PinData): boolean {
    if (!kinds[pin.kind]) return false;
    const st = stateSelect?.value ?? '';
    if (st && pin.state !== st) return false;
    const q = searchInput?.value.trim().toLowerCase() ?? '';
    if (q && !pin.search.includes(q)) return false;
    return true;
  }

  function applyFilters() {
    document.querySelectorAll<SVGElement>('[data-pin]').forEach((el) => {
      el.classList.toggle(
        'pin-hidden',
        !matches({
          kind: el.dataset.pin!,
          search: el.dataset.search!,
          state: el.dataset.state!,
        })
      );
    });
    googleApply?.();
    if (countEl) countEl.textContent = String(allPins.filter(matches).length);
  }

  searchInput?.addEventListener('input', applyFilters);
  stateSelect?.addEventListener('change', applyFilters);
  document.querySelectorAll<HTMLButtonElement>('.pin-toggles [data-kind]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kind = btn.dataset.kind!;
      kinds[kind] = !kinds[kind];
      btn.setAttribute('aria-pressed', String(kinds[kind]));
      applyFilters();
    });
  });

  // Google Maps mode (PUBLIC_GMAPS_API_KEY set): live-guide pins navigate
  // to the city guide; upcoming towns render as small muted dots with
  // tooltips. Both respect the filter bar.
  const gmapEl = document.getElementById('us-gmap') as HTMLElement | null;
  if (gmapEl) {
    (async () => {
      const maps = await ensureGoogleMaps(gmapEl.dataset.gmapsKey!);
      const map = new maps.Map(gmapEl, {
        center: { lat: 39.5, lng: -95.5 },
        zoom: 4,
        mapTypeControl: false,
        streetViewControl: false,
        gestureHandling: 'cooperative',
      });
      const gmarkers: { marker: { setVisible(v: boolean): void }; pin: PinData }[] = [];
      const upcoming = JSON.parse(gmapEl.dataset.upcoming!) as {
        name: string; code: string; state: string; lat: number; lng: number; tier: number;
      }[];
      for (const t of upcoming) {
        const marker = new maps.Marker({
          map,
          position: { lat: t.lat, lng: t.lng },
          title: `${t.name}, ${t.code} — coming soon`,
          clickable: false,
          optimized: true,
          icon: {
            path: maps.SymbolPath.CIRCLE,
            scale: t.tier === 1 ? 3.2 : 2.4,
            fillColor: '#6d8b74',
            fillOpacity: 0.45,
            strokeWeight: 0,
          },
        });
        gmarkers.push({
          marker,
          pin: {
            kind: 'soon',
            search: `${t.name} ${t.state} ${t.code}`.toLowerCase(),
            state: t.code,
          },
        });
      }
      const cities = JSON.parse(gmapEl.dataset.cities!) as {
        name: string; code: string; state: string; slug: string; lat: number; lng: number;
      }[];
      for (const c of cities) {
        const marker = new maps.Marker({
          map,
          position: { lat: c.lat, lng: c.lng },
          title: `${c.name}, ${c.code} — open the guide`,
          icon: {
            path: maps.SymbolPath.CIRCLE,
            scale: 8,
            fillColor: '#c05f33',
            fillOpacity: 0.95,
            strokeColor: '#ffffff',
            strokeWeight: 2,
          },
        });
        marker.addListener('click', () => location.assign(`/${c.slug}/`));
        gmarkers.push({
          marker,
          pin: {
            kind: 'live',
            search: `${c.name} ${c.state} ${c.code}`.toLowerCase(),
            state: c.code,
          },
        });
      }
      googleApply = () =>
        gmarkers.forEach(({ marker, pin }) => marker.setVisible(matches(pin)));
      googleApply();
    })().catch(() => {
      gmapEl.textContent = 'Map failed to load — every guide is linked in the city list just below.';
    });
  }
</script>
