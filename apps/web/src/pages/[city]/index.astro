---
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/Photo.astro';
import DogEaredIndex from '~/components/DogEaredIndex.astro';
import CityVenueMap from '~/components/CityVenueMap.astro';
import AdSlot from '~/components/AdSlot.astro';
import { getCities } from '~/lib/config';
import { venuesForCity } from '~/lib/venues';
import { breadcrumbJsonLd } from '~/lib/jsonld';
import { BRAND_NAME } from '~/lib/site';

export async function getStaticPaths() {
  return getCities()
    .filter((c) => c.launched)
    .map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const venues = await venuesForCity(city.slug);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: `${city.name}, ${city.state_code}`, url: `/${city.slug}/` },
];
---

<Base
  title={`Dog-Friendly ${city.name}, ${city.state_code} — Verified Guide | ${BRAND_NAME}`}
  description={`${city.hero.subhead} Every dog policy verified against an official source.`}
  jsonld={[breadcrumbJsonLd(crumbs)]}
  ogImage={`/og/${city.slug}.png`}
>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
  </div>

  <header class="page-head">
    <div class="wrap head-row">
      <div>
        <p class="eyebrow">{city.name}, {city.state}</p>
        <h1>{city.hero.headline}</h1>
      </div>
      {city.regulations.length > 0 && (
        <a class="rules-link" href="#dog-rules">Local dog rules ↓</a>
      )}
    </div>
  </header>

  {venues.length > 0 && <CityVenueMap city={city} venues={venues} />}

  <section class="band">
    <div class:list={['wrap', { 'hero-split': city.hero_image }]}>
      <div>
        <p class="lede">{city.intro}</p>
      </div>
      {city.hero_image && (
        <Photo
          path={city.hero_image}
          alt={city.hero_image_alt}
          credit={city.hero_image_credit}
          creditUrl={city.hero_image_credit_url}
          width={720}
          loading="lazy"
        />
      )}
    </div>
  </section>

  <DogEaredIndex city={city} />

  {venues.length === 0 && (
    <section class="band">
      <div class="wrap">
        <p class="building">
          <strong>Verified listings are in progress for {city.name}.</strong>
          Every venue we publish gets its dog policy checked against an
          official source first — the local rules below are already verified,
          and listings land here as they clear that bar.
        </p>
      </div>
    </section>
  )}

  <AdSlot placement="below-hero" />

  {city.regulations.length > 0 && (
    <section class="band band--tint" id="dog-rules">
      <div class="wrap">
        <h2>Local dog rules</h2>
        <ul class="reg-list">
          {city.regulations.map((reg) => (
            <li>
              <p class="reg-summary">{reg.summary}</p>
              <p class="reg-detail">
                {reg.detail}
                {' '}<a href={reg.source_url} rel="nofollow noopener" target="_blank">Official source ({reg.jurisdiction})</a>
              </p>
            </li>
          ))}
        </ul>
        {city.seasonal_notes.length > 0 && (
          <div class="seasonal">
            <h3>Right now / seasonal</h3>
            <ul>
              {city.seasonal_notes.map((note) => <li>{note}</li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {city.resources.length > 0 && (
    <section class="band band--tint">
      <div class="wrap">
        <h2>Official resources</h2>
        <p class="res-lede">The primary sources we verify against.</p>
        <ul class="res-list">
          {city.resources.map((res) => (
            <li>
              <a href={res.url} rel="noopener nofollow" target="_blank">{res.label}</a>
              <span>{res.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .page-head {
    padding: 0.25rem 0 0.9rem;
  }
  .page-head h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    margin: 0;
  }
  .page-head .eyebrow {
    margin-bottom: 0.15rem;
  }
  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .rules-link {
    font-size: 0.9rem;
    font-weight: 650;
    white-space: nowrap;
    margin-bottom: 0.35rem;
  }
  #dog-rules {
    scroll-margin-top: 4.5rem;
  }
  .hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2.5rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero-split {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .res-lede {
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .res-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.7rem;
    max-width: 48rem;
  }
  .res-list a {
    font-weight: 650;
  }
  .res-list span {
    display: block;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .building {
    max-width: 44rem;
    background: var(--clay-soft);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.3rem;
    color: var(--ink-soft);
  }
  .building strong {
    color: var(--ink);
    display: block;
    margin-bottom: 0.2rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 42rem;
  }
  .reg-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.1rem;
    max-width: 48rem;
  }
  .reg-summary {
    font-weight: 650;
    margin: 0 0 0.2rem;
  }
  .reg-detail {
    font-size: 0.93rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .seasonal {
    margin-top: 1.75rem;
    background: var(--clay-soft);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.3rem;
    max-width: 48rem;
  }
  .seasonal h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }
  .seasonal ul {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.95rem;
  }
</style>
