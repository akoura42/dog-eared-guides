---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import DogPolicyBlock from '~/components/DogPolicyBlock.astro';
import Photo from '~/components/Photo.astro';
import GoogleReviews from '~/components/GoogleReviews.astro';
import VenueLocationMap from '~/components/VenueLocationMap.astro';
import VenueMenu from '~/components/VenueMenu.astro';
import AdSlot from '~/components/AdSlot.astro';
import AffiliateCTA from '~/components/AffiliateCTA.astro';
import AffiliateDisclosure from '~/components/AffiliateDisclosure.astro';
import { getCollection } from 'astro:content';
import { getCity, getCategoryByKey } from '~/lib/config';
import { venueSlug } from '~/lib/venues';
import { venueJsonLd, breadcrumbJsonLd } from '~/lib/jsonld';
import {
  lodgingAffiliateUrl,
  viatorAffiliateUrl,
  PET_INSURANCE_URL,
  PET_INSURANCE_PARTNER,
} from '~/lib/affiliate';
import PetInsuranceCTA from '~/components/PetInsuranceCTA.astro';
import { BRAND_NAME } from '~/lib/site';

export async function getStaticPaths() {
  const venues = await getCollection('venues');
  return venues.map((venue) => ({
    params: { city: venue.data.city, slug: venueSlug(venue) },
    props: { venue },
  }));
}

const { venue } = Astro.props;
const d = venue.data;
const city = getCity(d.city);
const category = getCategoryByKey(d.category);
const { Content } = await render(venue);

// Category hub pages exist from 1 venue up (thin ones are noindexed)
const categoryHubUrl = `/${d.city}/${category.slug}/`;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: city.name, url: `/${city.slug}/` },
  ...(categoryHubUrl ? [{ name: category.label, url: categoryHubUrl }] : []),
  { name: d.name, url: `/${d.city}/venues/${venueSlug(venue)}/` },
];

const affiliate = d.affiliate;
const affiliateUrl = affiliate?.viator_url
  ? viatorAffiliateUrl(affiliate.viator_url)
  : affiliate?.booking_url
    ? lodgingAffiliateUrl(affiliate.booking_url)
    : null;

// Pet-insurance module: emergency-vet pages and lodging that charges a
// pet fee — the two contexts where the reader is already looking at what
// an emergency or a fee costs. Renders only when a partner is configured.
const insuranceConfigured = Boolean(PET_INSURANCE_URL && PET_INSURANCE_PARTNER);
const showInsurance =
  insuranceConfigured &&
  (d.tags.includes('emergency-vet') ||
    (d.category === 'stay' && d.dog_policy.fee !== null));
const insuranceContext =
  d.category === 'stay' && d.dog_policy.fee
    ? `The pet fee here is ${d.dog_policy.fee}.`
    : undefined;

const hasAffiliate = Boolean(affiliateUrl) || showInsurance;

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${d.name} ${d.address}`
)}`;
---

<Base
  title={`${d.name} — Dog-Friendly ${category.singular[0].toUpperCase() + category.singular.slice(1)} in ${city.name} | ${BRAND_NAME}`}
  description={`${d.summary} Dog policy verified ${d.verification.last_verified.toISOString().slice(0, 10)}.`}
  jsonld={[venueJsonLd(venue, city), breadcrumbJsonLd(crumbs)]}
  ogImage={`/og/${d.city}-${venueSlug(venue)}.png`}
>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />

    <article class="venue">
      <header>
        <p class="eyebrow">
          {category.label} · {city.name}, {city.state_code}
          {d.field_notes && <span class="field-tested">Field-tested</span>}
        </p>
        <h1>{d.name}</h1>
        <p class="summary">{d.summary}</p>
        <p class="meta">
          <a href={mapsUrl} rel="noopener" target="_blank">{d.address}</a>
          {d.phone && <> · <a href={`tel:${d.phone.replace(/[^+\d]/g, '')}`}>{d.phone}</a></>}
          {d.website && <> · <a href={d.website} rel="noopener nofollow" target="_blank">Website</a></>}
          {' '}· <a href={mapsUrl} rel="noopener nofollow" target="_blank">Google reviews</a>
        </p>
      </header>

      <Photo
        path={d.image}
        alt={d.image_alt}
        credit={d.image_credit}
        creditUrl={d.image_credit_url}
        loading="eager"
      />

      <DogPolicyBlock venue={venue} />

      {d.field_notes && (
        <aside class="field-notes">
          <p class="fn-head">Field notes</p>
          <p>{d.field_notes}</p>
        </aside>
      )}

      <VenueLocationMap
        name={d.name}
        address={d.address}
        lat={d.lat}
        lng={d.lng}
        placeId={d.google_place_id}
      />

      <GoogleReviews
        name={d.name}
        address={d.address}
        placeId={d.google_place_id}
        gmapsUrl={mapsUrl}
      />

      {hasAffiliate && <AffiliateDisclosure />}
      {affiliateUrl && (
        <AffiliateCTA
          kind={affiliate?.viator_url ? 'viator' : 'lodging'}
          href={affiliateUrl}
          note={affiliate?.viator_url ? 'Booking through this link supports the site.' : 'Rates shown by our booking partner; booking through this link supports the site.'}
        />
      )}
      {showInsurance && <PetInsuranceCTA context={insuranceContext} />}

      <div class="prose body">
        <Content />
      </div>

      <VenueMenu venue={venue} />

      <AdSlot placement="end-of-content" />

      <footer class="verify-note">
        <p>
          <strong>Spotted a change?</strong> Policies move fast in
          {city.name}. If this doesn't match what you found on the ground,
          <a href="/how-we-verify/">let us know</a> — we re-verify every
          listing at least every 90 days.
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .venue {
    max-width: 46rem;
    padding-bottom: 2rem;
  }
  header {
    margin-top: 1rem;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .meta {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .body {
    margin-top: 1rem;
  }
  .field-tested {
    display: inline-block;
    background: var(--pine);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .field-notes {
    background: color-mix(in srgb, var(--moss) 14%, var(--paper));
    border-left: 3px solid var(--pine);
    border-radius: var(--radius);
    padding: 0.9rem 1.2rem;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .fn-head {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pine);
    margin: 0 0 0.3rem;
  }
  .field-notes p:last-child {
    margin: 0;
  }
  .verify-note {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
</style>
